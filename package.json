{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "k8o",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless proxy start --https && turbo run dev --filter=!main-k8ordo",
    "dev:k8ordo": "portless proxy start --https && turbo run dev --filter=!main",
    "build": "turbo run build",
    "check": "vp check && turbo run check:css",
    "check:write": "vp check --fix",
    "ls-lint": "ls-lint",
    "inspect": "vp-inspect",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "storybook": "turbo run storybook",
    "turbo:devtools": "turbo devtools",
    "install-playwright": "playwright install --with-deps chromium",
    "knip": "knip",
    "check:css": "turbo run check:css"
  },
  "devDependencies": {
    "@k8o/oxc-config": "catalog:",
    "@ls-lint/ls-lint": "2.3.2",
    "@repo/oxlint-plugin": "workspace:*",
    "@types/node": "24.19.2",
    "knip": "6.42.1",
    "playwright": "1.64.1",
    "portless": "0.15.8",
    "turbo": "2.11.9",
    "typescript": "7.0.2",
    "vite-plus": "1.3.0",
    "vite-plus-inspector": "1.0.0",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "packageManager": "pnpm@12.14.0"
}
