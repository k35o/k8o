{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "k8o",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless proxy start --https && turbo run dev",
    "build": "turbo run build",
    "check": "turbo run typegen && vp check && turbo run check:css",
    "check:write": "turbo run typegen && vp check --fix",
    "ls-lint": "ls-lint",
    "typegen": "turbo run typegen",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "storybook": "turbo run storybook",
    "knip": "knip",
    "check:css": "turbo run check:css"
  },
  "devDependencies": {
    "@k8o/oxc-config": "catalog:",
    "@ls-lint/ls-lint": "2.3.2",
    "@repo/oxlint-plugin": "workspace:*",
    "@types/node": "26.6.6",
    "knip": "6.44.1",
    "playwright": "1.64.1",
    "portless": "0.15.13",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vite-plus": "1.4.0",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "packageManager": "pnpm@12.17.0"
}
