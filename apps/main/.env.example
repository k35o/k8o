# Vercel では、URL と preview のトークンを Shared Environment Variables に置き、api と共有する。本番のトークンは main だけの読み取り専用で、プロジェクトに置く
K8O_TURSO_DATABASE_URL="https://db.k8o.localhost"
K8O_TURSO_AUTH_TOKEN=dummy
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
GITHUB_TOKEN=
# Push 購読の公開鍵（api の VAPID_PRIVATE_KEY と対）。Vercel では Shared Environment Variables に置き、api と共有する
VAPID_PUBLIC_KEY=
# api からの /api/revalidate 呼び出しを認可する共有 secret（未設定なら常に401）。Vercel では Shared Environment Variables に置き、api と共有する
REVALIDATE_SECRET=
