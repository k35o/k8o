{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@content/*": ["./src/content/*"]
    },
    "types": ["node", "vite/client", "vitest/importMeta"],
    "rootDirs": [".", "./__generated__"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".k8ordo/**/*.ts",
    ".storybook/*.ts",
    ".storybook/*.tsx",
    "__generated__"
  ],
  "exclude": ["node_modules", "dist"]
}
