{
  "name": "main",
  "version": "1.0.0",
  "private": true,
  "description": "k8o site",
  "type": "module",
  "scripts": {
    "dev": "portless run next dev --inspect",
    "build": "next build",
    "start": "next start",
    "analyze": "next experimental-analyze",
    "generate:browser-min-versions": "node --import ./scripts/register-ts-resolver.ts scripts/generate-browser-min-versions.ts",
    "compare:sites": "node --import ./scripts/register-ts-resolver.ts scripts/compare-sites.ts",
    "smoke:pages": "node --import ./scripts/register-ts-resolver.ts scripts/smoke-pages.ts",
    "generate:link-card-metadata": "node --import ./scripts/register-ts-resolver.ts scripts/generate-link-card-metadata.ts",
    "optimize:image": "node --import ./scripts/register-ts-resolver.ts scripts/optimize-image.ts",
    "type-check": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:vrt": "VRT=1 vitest run --project=storybook",
    "test:watch": "vitest",
    "test:ui": "vitest --ui --coverage",
    "coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "check:css": "better-css-modules check"
  },
  "dependencies": {
    "@k8o/html-nest": "catalog:",
    "@k8ordo/i18n": "catalog:",
    "@k8ordo/state": "catalog:",
    "@k8ordo/ui": "catalog:",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "catalog:",
    "@repo/code-highlight": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/helpers": "workspace:*",
    "@repo/mdx-preset": "workspace:*",
    "@vercel/speed-insights": "2.0.0",
    "budoux": "0.10.0",
    "hono": "catalog:",
    "next": "catalog:",
    "next-themes": "catalog:",
    "nuqs": "2.10.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remark": "15.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-mdx": "3.1.1",
    "uqr": "0.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-css-modules/cli": "catalog:",
    "@better-css-modules/core": "catalog:",
    "@better-css-modules/turbopack": "catalog:",
    "@better-css-modules/vite": "catalog:",
    "@repo/api": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-mcp": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/nextjs-vite": "catalog:",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "chromatic": "catalog:",
    "linkedom": "0.18.14",
    "msw": "3.0.3",
    "msw-storybook-addon": "3.0.3",
    "playwright": "1.64.1",
    "react-scan": "0.5.7",
    "sharp": "0.35.5",
    "storybook": "catalog:",
    "storybook-addon-determinism": "catalog:",
    "storybook-addon-mock-date": "catalog:",
    "storybook-addon-vrt": "catalog:",
    "vitest": "catalog:"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
