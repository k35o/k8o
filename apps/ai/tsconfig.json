{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "allowJs": true,
    "jsx": "preserve",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node", "vitest/importMeta"],
    "rootDirs": [".", "./__generated__"]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".storybook/*.ts",
    ".storybook/*.tsx",
    "__generated__"
  ],
  "exclude": ["node_modules"]
}
