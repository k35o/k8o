# ai の DB（認証と ai_*）。ローカル用の DB は用意していない
AI_TURSO_DATABASE_URL=
AI_TURSO_AUTH_TOKEN=
ALLOWED_EMAILS=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://ai.k8o.localhost/
# ローカル開発でログインを省略する（NODE_ENV=development のときのみ有効。本番では無視される）
LOCAL_AUTH_BYPASS=true
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 生成に使う Claude API の鍵。Vercel では Shared Environment Variables に置き、k8o-api と共有する
ANTHROPIC_API_KEY=
# 生成のレート制限（1ユーザーあたり直近1時間の上限。既定 60）。暴走時のコスト抑制。
AI_GENERATE_LIMIT_PER_HOUR=60
# エージェントの tool が k8o の記事と運営のデータ（お問い合わせとブラウザからのレポートを含む）を読むオーナー API（https://api.k8o.me/owner/*）のトークン。
# 本番は api の OWNER_API_TOKEN_AI、preview は OWNER_API_TOKEN_AI_PREVIEW と同じ値を置く
OWNER_API_TOKEN=
# エージェントの tool が k35o の GitHub のリポジトリを読む、読み取り専用の fine-grained PAT。
# Vercel では本番と preview に別の PAT を Sensitive で置く
GITHUB_READ_TOKEN=
