{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "target": "esnext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "incremental": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@content/*": ["../main/src/content/*"],
      "@playgrounds/*": ["../main/src/playgrounds/*"]
    },
    "types": ["node", "vite/client", "vitest/importMeta"],
    "rootDirs": [
      ".",
      "./__generated__",
      "../main/src/playgrounds",
      "../main/__generated__/src/playgrounds"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".k8ordo/**/*.ts",
    ".storybook/*.ts",
    ".storybook/*.tsx",
    "__generated__"
  ],
  "exclude": ["node_modules", "dist"]
}
