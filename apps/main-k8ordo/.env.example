# Vercel では main のプロジェクトの環境変数を使う（preview も main と同じプロジェクトに出す）
# ビルドが記事・スライド・トーク・Readings・Browser Support・通知の履歴を読む k8o の DB
K8O_TURSO_DATABASE_URL="https://db.k8o.localhost"
K8O_TURSO_AUTH_TOKEN=dummy
GOOGLE_ANALYTICS_ID=
# /notifications の購読の公開鍵（api の VAPID_PRIVATE_KEY と対）。ビルドでページが読み、HTML とペイロードに出る
VAPID_PUBLIC_KEY=
