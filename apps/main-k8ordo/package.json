{
  "name": "main-k8ordo",
  "version": "1.0.0",
  "private": true,
  "description": "k8o site on k8ordo",
  "type": "module",
  "scripts": {
    "dev": "portless run vite dev",
    "build": "vite build",
    "type-check": "better-css-modules generate && tsc --noEmit",
    "test": "vitest run",
    "test:vrt": "VRT=1 vitest run --project=storybook",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6007 --no-open",
    "build-storybook": "storybook build",
    "check:css": "better-css-modules check"
  },
  "dependencies": {
    "@fontsource-variable/m-plus-2": "5.3.1",
    "@k8ordo/color-scheme": "catalog:",
    "@k8ordo/i18n": "catalog:",
    "@k8ordo/state": "catalog:",
    "@k8ordo/ui": "catalog:",
    "@repo/code-highlight": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/helpers": "workspace:*",
    "@repo/mdx-preset": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "budoux": "0.10.0",
    "hono": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remark": "15.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-mdx": "3.1.1",
    "satori": "0.33.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-css-modules/cli": "catalog:",
    "@better-css-modules/core": "catalog:",
    "@better-css-modules/vite": "catalog:",
    "@k8ordo/framework": "catalog:",
    "@k8ordo/router": "catalog:",
    "@mdx-js/rollup": "3.1.1",
    "@repo/api": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-mcp": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "msw": "3.0.3",
    "msw-storybook-addon": "3.0.3",
    "oxc-transform-react": "catalog:",
    "playwright": "1.64.1",
    "react-scan": "0.5.7",
    "storybook": "catalog:",
    "storybook-addon-determinism": "catalog:",
    "storybook-addon-mock-date": "catalog:",
    "storybook-addon-vrt": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
