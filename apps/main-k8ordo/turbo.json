{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env",
        ".env.*",
        "$TURBO_ROOT$/apps/main/public/**",
        "$TURBO_ROOT$/apps/main/src/content/**",
        "$TURBO_ROOT$/apps/main/src/playgrounds/**",
        "$TURBO_ROOT$/apps/main/src/features/browser-support/infrastructure/browser-min-versions.json"
      ]
    },
    "type-check": {
      "dependsOn": ["transit", "main#type-check"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/main/src/content/**",
        "$TURBO_ROOT$/apps/main/src/playgrounds/**",
        "$TURBO_ROOT$/apps/main/src/features/browser-support/infrastructure/browser-min-versions.json"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/main/src/content/**",
        "$TURBO_ROOT$/apps/main/src/playgrounds/**",
        "$TURBO_ROOT$/pnpm-lock.yaml"
      ]
    }
  }
}
