{
  "name": "@repo/api",
  "version": "1.0.0",
  "private": true,
  "description": "k8o API (cron jobs, owner MCP, and public routes)",
  "type": "module",
  "exports": {
    "./public": {
      "types": "./src/public.ts"
    }
  },
  "scripts": {
    "dev": "portless",
    "dev:app": "NODE_ENV=development tsx watch --env-file-if-exists=.env.local src/dev.ts",
    "build": "vp pack",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui --coverage",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "catalog:",
    "@modelcontextprotocol/server": "2.3.0",
    "@mozilla/readability": "0.6.0",
    "@repo/database": "workspace:*",
    "@repo/helpers": "workspace:*",
    "ai": "catalog:",
    "hono": "catalog:",
    "linkedom": "0.18.13",
    "rss-parser": "3.13.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.3",
    "@modelcontextprotocol/client": "2.3.0",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "tsx": "4.23.15",
    "vitest": "catalog:"
  }
}
