# Vercel では、URL と preview のトークンを Shared Environment Variables に置き、main と共有する。本番のトークンは api だけの読み書きで、プロジェクトに置く
K8O_TURSO_DATABASE_URL="https://db.k8o.localhost"
K8O_TURSO_AUTH_TOKEN=dummy
# VAPID_PUBLIC_KEY は Vercel では Shared Environment Variables に置き、main と共有する
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Vercel Cron の認可（Authorization: Bearer と比較）。未設定だと cron が常に 401 になり記事同期・browser-support 同期が止まる
CRON_SECRET=
# Claude Code から /mcp を使うための Bearer。Claude Code 側はルートの fnox.toml の K8O_API_MCP_TOKEN（profile: bot）を .mcp.json の headersHelper で渡す
MCP_TOKEN=
# /owner/* を使うための Bearer。クライアントごとに分け、ai の本番は OWNER_API_TOKEN_AI、ai の preview は OWNER_API_TOKEN_AI_PREVIEW と同じ値を持つ。どちらも未設定なら常に 401
# お問い合わせの本文とレポートを読める鍵なので、Vercel に Sensitive（画面では Secret と出る）で置く。Sensitive でない値は、prebuilt の workflow の vercel pull が、依存のコードも動くビルドの runner に書き出すため
OWNER_API_TOKEN_AI=
OWNER_API_TOKEN_AI_PREVIEW=
# reading-list の要約に使う Claude API の鍵。Vercel では Shared Environment Variables に置き、ai と共有する
ANTHROPIC_API_KEY=
