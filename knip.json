{
  "$schema": "https://unpkg.com/knip/schema.json",
  "ignore": [
    "apps/main/public/sw.js",
    "apps/main/public/playgrounds/shared-worker.worker.js"
  ],
  "treatConfigHintsAsErrors": true,
  "tags": ["-lintignore"],
  "ignoreBinaries": ["mise", "vercel"],
  "workspaces": {
    "apps/main": {
      "ignoreDependencies": ["chromatic"],
      "entry": [
        "better-css-modules.config.ts",
        "src/content/blog/*/article.mdx"
      ]
    },
    "apps/main-k8ordo": {
      "entry": [
        "better-css-modules.config.ts",
        "src/routes/**/{page,layout,not-found,error}.tsx"
      ]
    },
    "apps/ai": {
      "ignoreDependencies": ["chromatic"],
      "entry": ["better-css-modules.config.ts"]
    },
    "packages/oxlint-plugin": {
      "ignore": ["tests/fixtures/**"]
    },
    "packages/auth-shell": {
      "entry": ["better-css-modules.config.ts"]
    }
  }
}
