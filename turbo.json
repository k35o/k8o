{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "globalEnv": ["NODE_ENV", "PORTLESS_URL", "VERCEL_ENV"],
  "globalPassThroughEnv": [
    "CRON_SECRET",
    "GITHUB_TOKEN",
    "MAIN_REVALIDATE_URL",
    "REVALIDATE_SECRET"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "AI_GENERATE_LIMIT_PER_HOUR",
        "AI_TURSO_AUTH_TOKEN",
        "AI_TURSO_DATABASE_URL",
        "ALLOWED_EMAILS",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "K8O_TURSO_AUTH_TOKEN",
        "K8O_TURSO_DATABASE_URL",
        "NEXT_PUBLIC_GOOGLE_ANALYTICS_ID",
        "VAPID_PUBLIC_KEY"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "type-check": {
      "dependsOn": ["transit"],
      "outputs": ["tsconfig.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "check:css": {
      "dependsOn": ["transit"]
    }
  }
}
