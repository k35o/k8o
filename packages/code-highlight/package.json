{
  "name": "@repo/code-highlight",
  "version": "1.0.0",
  "private": true,
  "description": "MDXのコードブロックにシンタックスハイライトと注釈を付けるrehypeプラグイン (Shikiラッパー)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./parser": {
      "types": "./src/parser.ts",
      "default": "./src/parser.ts"
    },
    "./tokenize": {
      "types": "./src/tokenize.ts",
      "default": "./src/tokenize.ts"
    },
    "./tokenize-client": {
      "types": "./src/tokenize-client.ts",
      "default": "./src/tokenize-client.ts"
    },
    "./theme": {
      "types": "./src/theme.ts",
      "default": "./src/theme.ts"
    },
    "./styles.css": "./styles/annotate.css"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsgo --noEmit"
  },
  "dependencies": {
    "@shikijs/core": "4.4.2",
    "@shikijs/engine-javascript": "4.4.2",
    "@shikijs/langs": "4.4.2",
    "@shikijs/rehype": "4.4.2",
    "@shikijs/themes": "4.4.2",
    "shiki": "4.4.2"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@shikijs/types": "4.4.2",
    "@types/hast": "3.0.5",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  }
}
