{
  "name": "@repo/auth-shell",
  "version": "1.0.0",
  "private": true,
  "description": "ai の Better Auth の認証ゲートとアプリシェル",
  "type": "module",
  "exports": {
    "./auth-enabled": {
      "types": "./src/auth-enabled.ts",
      "default": "./src/auth-enabled.ts"
    },
    "./auth-route": {
      "types": "./src/auth-route.ts",
      "default": "./src/auth-route.ts"
    },
    "./error-page": {
      "types": "./src/error-page.tsx",
      "default": "./src/error-page.tsx"
    },
    "./global-error-content": {
      "types": "./src/global-error-content.tsx",
      "default": "./src/global-error-content.tsx"
    },
    "./proxy": {
      "types": "./src/proxy.ts",
      "default": "./src/proxy.ts"
    },
    "./public-layout": {
      "types": "./src/public-layout.tsx",
      "default": "./src/public-layout.tsx"
    },
    "./sign-in-page": {
      "types": "./src/sign-in-page.tsx",
      "default": "./src/sign-in-page.tsx"
    },
    "./sign-out-button": {
      "types": "./src/sign-out-button.tsx",
      "default": "./src/sign-out-button.tsx"
    },
    "./verify-session": {
      "types": "./src/verify-session.ts",
      "default": "./src/verify-session.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "better-css-modules generate && tsc --noEmit",
    "check:css": "better-css-modules check"
  },
  "dependencies": {
    "@repo/ai-database": "workspace:*",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@better-css-modules/cli": "catalog:",
    "@better-css-modules/core": "catalog:",
    "@k8ordo/i18n": "catalog:",
    "@k8ordo/ui": "catalog:",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "better-auth": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@k8ordo/i18n": "catalog:",
    "@k8ordo/ui": "catalog:",
    "better-auth": "catalog:",
    "next": "catalog:",
    "react": "catalog:"
  }
}
